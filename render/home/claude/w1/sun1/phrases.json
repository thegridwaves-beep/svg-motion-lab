{
 "0": [
  {
   "text": "The Sun just vanished.",
   "t": 0.368
  },
  {
   "text": "And you have no idea.",
   "t": 2.698
  }
 ],
 "1": [
  {
   "text": "Its light takes about eight minutes to reach you...",
   "t": 4.581
  },
  {
   "text": "so the sky stays bright.",
   "t": 7.327
  },
  {
   "text": "Even its pull on Earth keeps going,",
   "t": 8.981
  },
  {
   "text": "for eight more minutes.",
   "t": 10.956
  }
 ],
 "2": [
  {
   "text": "Then,",
   "t": 12.618
  },
  {
   "text": "at minute eight...",
   "t": 12.971
  },
  {
   "text": "the sky goes black.",
   "t": 14.242
  }
 ],
 "3": [
  {
   "text": "Earth stops circling,",
   "t": 16.011
  },
  {
   "text": "and flies off in a straight line into the dark.",
   "t": 17.658
  },
  {
   "text": "The Moon goes dark too.",
   "t": 20.511
  },
  {
   "text": "It only ever shone with sunlight.",
   "t": 22.134
  }
 ],
 "4": [
  {
   "text": "Within a week,",
   "t": 24.301
  },
  {
   "text": "the whole planet drops below zero Fahrenheit.",
   "t": 25.234
  },
  {
   "text": "Within a year...",
   "t": 28.268
  },
  {
   "text": "minus one hundred.",
   "t": 29.429
  }
 ],
 "5": [
  {
   "text": "So where do you run?",
   "t": 31.156
  },
  {
   "text": "Part two,",
   "t": 32.557
  },
  {
   "text": "tomorrow.",
   "t": 33.207
  },
  {
   "text": "Follow...",
   "t": 34.064
  },
  {
   "text": "or freeze.",
   "t": 34.932
  }
 ]
